# Rendu au démarrage par l'entrypoint nginx (envsubst) : seules les variables d'environnement
# définies sont remplacées, les variables nginx ($host, $uri…) restent intactes.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    server_tokens off;

    # En-têtes de sécurité. Les photos viennent des sites officiels des trois assemblées.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www2.assemblee-nationale.fr https://www.senat.fr https://www.europarl.europa.eu; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Sonde pour l'orchestrateur
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/ {
        proxy_pass ${BACK_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Fichiers à empreinte (hash dans le nom) : cache longue durée
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Application monopage : toute autre route renvoie index.html, jamais mis en cache
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
