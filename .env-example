# Copier ce fichier en .env puis adapter les valeurs :
#   cp .env-example .env
# .env est ignoré par git. En production, les secrets viennent d'OpenBao.

# --- PostgreSQL ---
POSTGRES_DB=avote
POSTGRES_USER=avote
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_PASSWORD=change-me

# --- Ports exposés sur la machine hôte (127.0.0.1 uniquement pour les bases) ---
FRONT_PORT=8080
BACK_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Ingestion des données parlementaires ---
# Cron Spring (sec min h jour mois jour-semaine), fuseau Europe/Paris
AVOTE_INGESTION_CRON=0 0 4 * * *
# Lance un import au démarrage si la base est vide
AVOTE_INGESTION_RUN_ON_STARTUP_IF_EMPTY=true
